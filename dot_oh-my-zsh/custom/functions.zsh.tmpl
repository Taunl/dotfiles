# 更换 neovim 配置
function vc() {
  mv ~/.config/nvim{,.mid}
  mv ~/.local/share/nvim{,.mid}
  mv ~/.local/state/nvim{,.mid}
  mv ~/.cache/nvim{,.mid}

  mv ~/.config/nvim{.bak,}
  mv ~/.local/share/nvim{.bak,}
  mv ~/.local/state/nvim{.bak,}
  mv ~/.cache/nvim{.bak,}

  mv ~/.config/nvim{.mid,.bak}
  mv ~/.local/share/nvim{.mid,.bak}
  mv ~/.local/state/nvim{.mid,.bak}
  mv ~/.cache/nvim{.mid,.bak}
}
