##  ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝   ╚═╝      ╚═╝      ╚═╝   

## A GPU-accelerated cross-platform terminal emulator
## see https://ghostty.org/docs/config


## ╭─────────────────────────────────────────────────────────╮
## │                         GENERAL                         │
## ╰─────────────────────────────────────────────────────────╯


## ===
font-family = "FiraCode Nerd Font Mono"
# font-family = "Lantinghei TC"
# 这个中文字体有粗体

# on mac
# font-family = "source Han Serif CN"
# font-family = "Noto Serif CJK SC"
font-size = 15
# font-thicken = true
# font-synthetic-style = true
# font-thicken = true


## 应是行高增加 5%
adjust-cell-height = 10% 

# --- Theme and Colors ---
theme = Kanagawa Wave

# --- Window and Appearance ---
## background-opacity = 1
## macos-titlebar-style = transparent
window-padding-x = 14
## window-padding-y = 10
## window-save-state = never
window-width = 80
window-height = 24
window-theme = auto

# 以下两个选项中 window-inherit-working-directory 高优先级，当其设置为 false 时，则再不
# window-inherit-working-directory = false
working-directory = home
# --- Cursor ---
cursor-style = bar
cursor-style-blink = true

# --- Mouse ---
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- Quick Terminal (Quake-style dropdown) ---
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --- Close behavior ---
confirm-close-surface = false

# --- Security ---
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Shell Integration ---
shell-integration = detect
shell-integration-features = cursor,sudo,no-title,ssh-env,ssh-terminfo,path


## ╭─────────────────────────────────────────────────────────╮
## │                         keybinds                        │
## ╰─────────────────────────────────────────────────────────╯

# ----- Tabs -----
# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface

# Splits
keybind = ctrl+s=new_split:auto
keybind = ctrl+tab=goto_split:next
keybind = ctrl+m=toggle_split_zoom
# keybind = ctrl+v=new_split:down
# keybind = cmd+shift+d=new_split:down
# keybind = cmd+alt+left=goto_split:left
# keybind = cmd+alt+right=goto_split:right
# keybind = cmd+alt+up=goto_split:top
# keybind = cmd+alt+down=goto_split:bottom

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Quick terminal global hotkey
keybind = global:ctrl+backquote=toggle_quick_terminal
# keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Splits management
keybind = cmd+shift+e=equalize_splits

# Reload config
keybind = cmd+shift+comma=reload_config

## ╭─────────────────────────────────────────────────────────╮
## │                       performance                       │
## ╰─────────────────────────────────────────────────────────╯

scrollback-limit = 25000000
